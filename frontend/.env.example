# ==============================================================================
# 📍 SPOTLOG ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# 보안을 위해 실제 API 키 및 자격 증명은 포함하지 않습니다.
# 본 파일을 복사하여 '.env' 파일을 생성한 후, 각 항목에 맞는 실제 키 값을 입력하십시오.


# ==============================================================================
# 📱 FRONTEND CONFIGURATION (React / Vite)
# ==============================================================================

# React 애플리케이션 실행 포트 번호
VITE_PORT=5173

# 외부 데이터 처리 전용 FastAPI 서버 기본 URL
VITE_API_BASE_URL=http://localhost:8000


# ==============================================================================
# 🔑 BAAS CONFIGURATION (Supabase)
# ==============================================================================

# Supabase 프로젝트 고유 주소 (Project URL)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Supabase 익명 접근 키 (Anon Public API Key - RLS 기반 데이터 격리에 필수)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# ==============================================================================
# 🗺️ MAP & LOCATION API CONFIGURATION (Kakao Developers)
# ==============================================================================

# 카카오 JavaScript 키 (지도 SDK 렌더링용)
VITE_KAKAO_MAP_API_KEY=your_kakao_javascript_key_here

# 카카오 REST API 키 (Kakao 로그인 및 역지오코딩 백엔드 연동 필요시 사용)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here


# ==============================================================================
# ⚡ BACKEND SERVER CONFIGURATION (Python FastAPI)
# ==============================================================================

# FastAPI 서버 실행 포트 번호
PORT=8000

# 프론트엔드 접근 허용을 위한 CORS 설정 (React 주소)
CORS_ALLOWED_ORIGINS=http://localhost:5173


# ==============================================================================
# 🧠 EXTERNAL DATA & AI API KEY CONFIGURATION
# ==============================================================================

# 구글 인공지능 API 키 (Gemini 2.5 Flash 기반 컨텍스트 데이트 코스 추천 엔진)
GEMINI_API_KEY=your_gemini_2_5_flash_api_key_here

# 공공데이터포털 기상청 ASOS API 인코딩/디코딩 키 (일별 평균 기온 및 날씨 데이터 적재)
KMA_ASOS_API_KEY=your_korea_meteorological_data_portal_key_here